<%- include('./partials/header') %> <%- include('./partials/navbar') %>
<div class="container mt-5">
  <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3">
    <% if (locals.user && locals.blogs.length > 0) { %> <% blogs.forEach(blog => { %>
    <div class="col">
      <div class="card shadow-sm">
        <img src="<%= blog.coverImage %>" alt="blog images" class="img-fluid" />
        <div class="card-body">
          <p class="card-title fs-5 fw-bold">
            <%= blog.title.slice(0, 45) %>...
          </p>
          <p class="card-text"><%= blog.content.slice(0, 60) %></p>
          <div class="btn-group">
            <button type="button" class="btn btn-primary">
              <a href="/<%=blog._id%>" class="nav-link">Continue reading...</a>
            </button>
          </div>
        </div>    
      </div>
    </div>
    <% }) %> <% } else{%>
    <div class="container" style="width: 100%; margin: 1rem auto">
      <div class="p-5 text-center shadow rounded-3">
        <img
          src="/assets/blogger.png"
          alt="blogger logo"
          class="img-fluid"
          width="50"
        />
        <h1 class="text-body-emphasis">
          <% if (locals.user) { %>
            No Blogs Posted Yet, <br />
            Create Your Blogs
          <% } else { %>
            Create a new account or Signin existing
          <% } %>
        </h1>
        <div class="d-inline-flex gap-2 my-4 flex_column">
          <% if (locals.user) { %>
          <button
            class="d-inline-flex align-items-center btn btn-primary btn-lg px-4 rounded-pill"
            type="button"
          >
            <a href="/new" class="nav-link">Create Blogs</a>
          </button>
          <% } else { %>
            <button
              class="d-inline-flex align-items-center btn btn-primary btn-lg px-4 rounded-pill"
              type="button"
            >
              <a href="/signup" class="nav-link">Create Account</a>
            </button>
            <button
              class="btn btn-outline-secondary btn-lg px-4 rounded-pill"
              type="button"
            >
              <a href="/login" class="nav-link">Login Instead</a>
            </button>
          <% } %>
        </div>
      </div>
    </div>
    <% } %>
  </div>
</div>

